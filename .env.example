# Copy to .env.local. Do not commit real values.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
# Required for public AI requests; editor and PDF work without these.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_HASH_SECRET=
AI_TIMEOUT_MS=55000
AI_MAX_OUTPUT_TOKENS=3000
# Set both only after reviewing the provider's processing terms.
AI_ENABLED=false
AI_PROVIDER_LABEL=Google Gemini
AI_PRIVACY_URL=https://ai.google.dev/gemini-api/terms
